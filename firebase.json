{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ],
  "firestore": {
    "database": "(default)",
    "indexes": "firestore.index.json",
    "rules": "firestore.rules"
  },
  "hosting": [
    {
      "site": "devlog-staging",
      "public": "hosting/staging",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "/api/todos/**",
          "run": {
            "serviceId": "http-api",
            "region": "asia-northeast3"
          }
        },
        {
          "source": "/api/web-pages/**",
          "run": {
            "serviceId": "http-api",
            "region": "asia-northeast3"
          }
        },
        {
          "source": "/api/push-notifications/**",
          "run": {
            "serviceId": "http-api",
            "region": "asia-northeast3"
          }
        },
        {
          "source": "/api/auth/google/**",
          "run": {
            "serviceId": "http-api",
            "region": "asia-northeast3"
          }
        },
        {
          "source": "/api/auth/github/callback",
          "function": {
            "functionId": "api",
            "region": "asia-northeast3"
          }
        },
        {
          "source": "/api/**",
          "function": {
            "functionId": "api",
            "region": "asia-northeast3"
          }
        }
      ]
    },
    {
      "site": "devlog-auth-prod",
      "public": "hosting/staging",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "/api/auth/github/callback",
          "function": {
            "functionId": "api",
            "region": "asia-northeast3"
          }
        }
      ]
    }
  ],
  "emulators": {
    "auth": {
      "port": 9099
    },
    "functions": {
      "port": 5001
    },
    "firestore": {
      "port": 8080
    },
    "ui": {
      "enabled": true
    },
    "singleProjectMode": true,
    "pubsub": {
      "port": 8085
    }
  }
}
