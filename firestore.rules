rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function userDataWriteAllowed(userId) {
      return !exists(/databases/$(database)/documents/authCredentials/$(userId)) ||
        get(/databases/$(database)/documents/authCredentials/$(userId)).data.deletionStartedAt == null;
    }

    // 모든 사용자 데이터는 users 컬렉션 아래에 위치
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId &&
        userDataWriteAllowed(userId);

      // 서브 컬렉션까지 모두 적용
      match /{document=**} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write, delete: if request.auth != null && request.auth.uid == userId &&
          userDataWriteAllowed(userId);
      }
    }

  }
}
